.git
**/node_modules
**/.next
**/.expo
**/.turbo
**/dist
**/*.log
**/.DS_Store

# env dosyalari imaja gomulmesin; degerler --build-arg ile geliyor
**/.env
**/.env.*
.env.supabase

mobile-app/ios
mobile-app/android
