# Supabase MCP credentials (local stdio server, no `supabase login` needed)
# Copy this file to `.env.supabase` (gitignored) and fill the value.
#
# This is a SUPABASE PERSONAL ACCESS TOKEN (PAT) — account-level, for the
# Management API. It is NOT the project service_role key and NOT the anon key.
# Create one at: https://supabase.com/dashboard/account/tokens
#
# dotenv-cli loads this file and passes the var to the MCP server process,
# so the MCP authenticates without an interactive OAuth login.

SUPABASE_ACCESS_TOKEN=
